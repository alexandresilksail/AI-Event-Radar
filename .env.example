# ===== AI Event Radar — 环境配置示例 =====
# 复制为 .env 并修改。敏感凭证绝不进入 Git。

# --- 应用 ---
ENV=production
# SQLite（开发）: sqlite:///./data/radar.db
# PostgreSQL（生产）: postgresql+psycopg://radar:密码@db:5432/radar
DATABASE_URL=sqlite:///./data/radar.db

# --- 认证（生产必须修改！）---
JWT_SECRET=请替换为至少32位随机字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码

# --- 调度 ---
SCHEDULER_ENABLED=true
DEFAULT_FREQUENCY_MINUTES=60
CRAWL_TIMEOUT_SECONDS=30
MAX_CONCURRENT_CRAWLS=4
MAX_RETRY=3
USER_AGENT="AIEventRadar/1.0 (+https://your-site.example.com/bot; respects robots.txt)"

# --- AI 结构化抽取（可选，OpenAI 兼容接口）---
# 留空 = 仅使用规则抽取（不产生任何 API 费用）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- 搜索引擎发现（可选）---
# serper | tavily | bing，留空 = 禁用全网发现（不伪装实现）
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- 邮件通知默认凭证（可选，也可在通知规则中配置）---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
