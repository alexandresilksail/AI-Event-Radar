# ===== AI Event Radar — 环境配置示例 =====
# 复制为 .env 并修改。所有敏感值仅为占位符，切勿把真实密钥提交到 Git。

# --- 应用 ---
# 生产必须是 production；dev 跳过启动安全校验
ENV=production
# api = Web 进程（不含调度器）；worker = 单独后台采集进程；all = 开发单进程
ROLE=all

# --- 数据库（生产必须 PostgreSQL；密码含特殊字符时 deploy 会 URL 编码）---
DB_USER=radar
DB_PASSWORD=请替换为强密码
DB_NAME=radar
DATABASE_URL=postgresql+psycopg://radar:请替换为强密码@db:5432/radar
# 生产保持 false：数据库迁移由独立的一次性 migrate 服务负责（docker-compose.prod.yml），
# API/Worker 多副本启动不会竞争同一迁移。dev 单进程可设为 true 以便自动建表。
AUTO_MIGRATE=false

# --- 认证（生产必须修改！生成: python -c "import secrets;print(secrets.token_urlsafe(48))"）---
JWT_SECRET=请替换为至少32位随机字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为12位以上强密码
# 可选：配置后用 POST /auth/reset-password 可凭此令牌重置管理员密码（留空禁用）
ADMIN_RESET_TOKEN=

# --- 公网入口 ---
# 唯一对外入口由 Nginx (80 端口) 提供；生产必须显式配置，不允许 *
HTTP_PORT=80
ALLOWED_ORIGINS=https://your-domain.example.com

# --- 调度（ROLE 含 worker/all 时有效）---
SCHEDULER_ENABLED=true
DEFAULT_FREQUENCY_MINUTES=60
CRAWL_TIMEOUT_SECONDS=30
MAX_CONCURRENT_CRAWLS=4
MAX_RETRY=3
SCHEDULER_LOCK_TTL=120
# worker 内嵌健康检查服务端口（仅容器内部使用，生产不对外发布）
WORKER_HEALTH_PORT=8001
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=5242880
# SSRF：仅允许这些 TCP 端口被抓取（逗号分隔）；默认 80,443
ALLOWED_PORTS=80,443
USER_AGENT="AIEventRadar/1.0 (+https://your-domain.example.com/bot; respects robots.txt)"

# --- AI 结构化抽取（可选，OpenAI 兼容接口；留空 = 仅规则抽取）---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- 搜索引擎发现（可选；未配置时明确提示，不伪装全网搜索）---
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- 邮件通知默认凭证（可选，也可在通知规则中配置；绝不写入日志）---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SSRF 例外主机（可选，逗号分隔）---
# 仅用于「运维自己配置、且确实部署在内网」的端点，例如内网 LLM 网关、内网邮件中继。
# SMTP_HOST 与 AI_BASE_URL 的主机名会自动加入，无需在此重复填写。
# 警告：这里填写的主机名将绕过 DNS 层的内网地址拦截，请只填写你自己控制的地址。
# 用户可配置的数据源 / 通知 webhook 不受此设置影响，仍逐次经过 SSRF 校验。
TRUSTED_INTERNAL_HOSTS=
